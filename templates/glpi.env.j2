# This file is only maintain by Ansible
GLPI_VERSION={{ item.glpi_version | default('11') }}
MARIADB_VERSION={{ item.mariadb_version | default ('12.3') }}

MARIADB_USER=glpi
MARIADB_PASSWORD={{ item.db_password }}
MARIADB_DATABASE={{ item.name }}
MARIADB_ROOT_PASSWORD={{ item.db_root_password }}

GLPI_MARKET_KEY={{ item.glpi_market_key }}
GLPI_TRUSTED_PROXIES={{ item.trusted_proxies_ips | default ('172.16.0.0/12,10.0.0.0/8') }}
